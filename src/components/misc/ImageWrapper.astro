---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	// Normalize glob keys: strip leading "../" sequences so we can match on a
	// stable "path relative to src/" key. Vite emits keys with a different
	// number of "../" prefixes depending on the platform (Windows -> "../x",
	// POSIX -> "../../x"), which broke the previous exact-string lookup.
	const fileMap: Record<string, () => Promise<ImageMetadata>> = {};
	for (const key of Object.keys(files)) {
		const rel = key.replace(/^(\.\.\/)+/, "");
		if (!fileMap[rel]) {
			fileMap[rel] = files[key] as () => Promise<ImageMetadata>;
		}
	}
	// Compute the target path relative to src/. basePath is relative to src/
	// ("/" means the src root); src is relative to basePath.
	const targetRel = path.posix
		.join(basePath === "/" ? "" : basePath, src)
		.replace(/^\.\//, "")
		.replace(/^src\//, "");
	const file = fileMap[targetRel];
	if (typeof file === "function") {
		img = await file();
	} else {
		console.error(
			`\n[ERROR] Image file not found: src/${targetRel} (src="${src}", basePath="${basePath}")`,
		);
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
